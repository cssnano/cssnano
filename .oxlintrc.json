{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./util/oxlint/merge-ir-plugin.js"],
  "ignorePatterns": ["packages/**/types/**", "util/oxlint/fixtures/**"],
  "plugins": ["typescript", "unicorn", "oxc", "promise", "import"],
  "categories": {
    "correctness": "error"
    //"suspicious": "error"
  },
  "rules": {
    "no-undef": "error",
    "array-callback-return": "error",
    "complexity": "error",
    "guard-for-in": "error",
    "max-depth": "error",
    "max-lines": ["error", { "max": 400 }],
    "no-bitwise": "error",
    "no-case-declarations": "error",
    "no-duplicate-imports": "error",
    "no-empty": "error",
    "no-nested-ternary": "error",
    "no-fallthrough": "error",
    "no-labels": "error",
    "no-param-reassign": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-shadow": "error",
    "no-throw-literal": "error",
    "no-underscore-dangle": "error",
    "no-unnecessary-await": "error",
    "no-useless-assignment": "error",
    "only-throw-error": "error",
    "no-promise-executor-return": "error",
    "prefer-const": ["error", { "destructuring": "all" }],
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-set-has": "error",
    "preserve-caught-error": "error",
    "promise/prefer-await-to-then": "error",
    "promise/always-return": "error",
    "unicorn/consistent-function-scoping": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-array-reduce": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/prefer-array-flat": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/prefer-type-error": "error",
    "promise/no-nesting": "error",
    "require-unicode-regexp": ["error", { "requireFlag": "v" }],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "no-self-compare": "error",
    "no-template-curly-in-string": "error",
    "no-unmodified-loop-condition": "error",
    "no-unreachable-loop": "error",
    "oxc/no-accumulating-spread": "error",
    "radix": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-unnecessary-slice-end": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-math-trunc": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/prefer-negative-index": "error",
    "unicorn/prefer-set-size": "error",
    "unicorn/prefer-array-index-of": "error",
    "prefer-object-spread": "error",
    "no-var": "error",
    "object-shorthand": "error",
    "prefer-arrow-callback": "error",
    "prefer-rest-params": "error",
    "prefer-object-has-own": "error",
    "prefer-numeric-literals": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-string-starts-ends-with": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    "unicorn/prefer-object-from-entries": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-default-parameters": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-global-this": "error",
    "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-string-replace-all": "error"
  },
  "overrides": [
    {
      "files": ["site/**"],
      "env": { "browser": true },
      "globals": { "Astro": "readonly" }
    },
    {
      // Defined by the site build; declared for the compiler in env.d.ts.
      "files": ["site/src/utils/embeddedBrowserTargets.js"],
      "globals": { "CSSNANO_PLAYGROUND_TARGETS": "readonly" }
    },
    {
      // Runs inside the browser through `evaluate`.
      "files": ["util/valueValidity.js"],
      "globals": { "CSS": "readonly" }
    },
    {
      "files": [
        "packages/cssnano/src/passes/merge/**",
        "packages/cssnano/src/passes/ir/**"
      ],
      "rules": {
        "merge-ir/link-edits-through-arena": [
          "error",
          {
            "allowed": ["packages/cssnano/src/passes/ir/blockRecords.js"],
            "required": [
              "packages/cssnano/src/passes/ir/blockRecords.js#linkBefore",
              "packages/cssnano/src/passes/ir/blockRecords.js#linkLast",
              "packages/cssnano/src/passes/ir/blockRecords.js#detach"
            ]
          }
        ],
        "merge-ir/cache-reads": [
          "error",
          {
            "allowed": [
              "packages/cssnano/src/passes/ir/declarationCache.js#declarationKeys",
              "packages/cssnano/src/passes/ir/declarationCache.js#receivingDeclarations",
              "packages/cssnano/src/passes/ir/blockChildren.js#holdsOnlyDeclarationsOf"
            ],
            "required": [
              "packages/cssnano/src/passes/ir/declarationCache.js#declarationKeys",
              "packages/cssnano/src/passes/ir/blockChildren.js#holdsOnlyDeclarationsOf"
            ]
          }
        ],
        "merge-ir/no-cache-local": "error"
      }
    },
    {
      "files": ["packages/cssnano/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": ["**/ir/consistencyChecks.js"] }
        ]
      }
    },
    {
      "files": [
        "packages/cssnano/src/passes/ir/runContext.js",
        "packages/cssnano/script/passes/merge/enableChecks.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/cssnano/test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": ["**/ir/consistencyChecks.js", "**/enableChecks.js"] }
        ]
      }
    },
    {
      "files": [
        "packages/cssnano/src/passes/ir/blockLinks.js",
        "packages/cssnano/src/passes/ir/declarationStamps.js"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/ruleRecord.js",
              "**/blockRecord.js",
              "**/declarationRecord.js",
              "**/ir/consistencyChecks.js"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/cssnano/src/pipeline/**",
        "packages/cssnano/src/plugins/postcss-merge-idents/lib/**",
        "packages/cssnano/src/plugins/postcss-reduce-idents/lib/**",
        "packages/cssnano/src/plugins/postcss-zindex/lib/**"
      ],
      "excludeFiles": ["packages/cssnano/src/pipeline/host.js"],
      "rules": {
        "merge-ir/no-postcss-in-window": "error"
      }
    },
    {
      "files": ["packages/cssnano/src/pipeline/**"],
      "excludeFiles": ["packages/cssnano/src/pipeline/host.js"],
      "rules": {
        "merge-ir/arena-edits-only": ["error", { "allowed": [] }],
        "merge-ir/no-captured-loop-state": ["error", { "allowed": [] }],
        "merge-ir/no-module-state": ["error", { "allowed": [] }]
      }
    },
    {
      "files": [
        "packages/cssnano/src/passes/merge/lib/rules/**",
        "packages/cssnano/src/passes/merge/lib/duplicates/**",
        "packages/cssnano/src/passes/ir/**"
      ],
      "rules": {
        "merge-ir/no-postcss-in-window": [
          "error",
          {
            "allowed": [
              "packages/cssnano/src/passes/ir/writeBack.js",
              "packages/cssnano/src/passes/ir/nodeTable.js",
              "packages/cssnano/src/passes/ir/writeSelector.js",
              "packages/cssnano/src/passes/ir/treeMatch.js",
              "packages/cssnano/src/passes/ir/buildRecords.js",
              "packages/cssnano/src/passes/ir/valueList.js",
              "packages/cssnano/src/passes/ir/recordsPlugin.js",
              "packages/cssnano/src/passes/ir/runContext.js",
              "packages/cssnano/src/passes/ir/runDriver.js"
            ]
          }
        ],
        "merge-ir/arena-edits-only": [
          "error",
          {
            "allowed": [
              "packages/cssnano/src/passes/ir/blockRecords.js",
              "packages/cssnano/src/passes/ir/arenaEdits.js",
              "packages/cssnano/src/passes/ir/valueEdits.js",
              "packages/cssnano/src/passes/ir/rawEdits.js",
              "packages/cssnano/src/passes/ir/treeEdits.js",
              "packages/cssnano/src/passes/ir/buildRecords.js"
            ]
          }
        ],
        "merge-ir/no-record-extends": "error",
        "merge-ir/checks-only-read": [
          "error",
          {
            "modules": [
              "packages/cssnano/src/passes/ir/consistencyChecks.js",
              "packages/cssnano/src/passes/ir/recordsCheck.js",
              "packages/cssnano/src/passes/ir/linkChecks.js"
            ],
            "allowed": []
          }
        ],
        "merge-ir/no-captured-loop-state": ["error", { "allowed": [] }]
      }
    },
    {
      "files": ["packages/cssnano/src/passes/**"],
      "rules": {
        "merge-ir/no-module-state": [
          "error",
          {
            "allowed": [
              "packages/cssnano/src/passes/ir/consistencyChecks.js#enabled"
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true,
    "node": true
  }
}
