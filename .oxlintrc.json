{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["site/_site/**", "packages/**/types/**"],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
   "unicorn/prefer-node-protocol": "error"
  },
  "env": {
    "builtin": true
  }
}
