{
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025"],
    "module": "nodenext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "newLine": "lf",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "types": ["node"],
    "moduleResolution": "nodenext",
    "isolatedModules": true
  },
  "references": [
    { "path": "packages/postcss-svgo" },
    { "path": "packages/cssnano" }
  ],
  "files": []
}
