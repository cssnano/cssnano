{
  "name": "cssnano-core",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm types && oxlint . && oxfmt --check",
    "fixlint": "oxfmt . && pnpm oxlint --fix .",
    "acquire": "pnpm --filter cssnano run acquire",
    "build:integration": "node util/buildFrameworks.js",
    "bench": "node ./util/benchmark/bench.js",
    "bench:smoke": "node ./util/benchmark/bench.js --mode=quick --runs=1",
    "bench:profile": "node ./util/benchmark/bench.js --profile --runs=1",
    "bench:compare": "node ./util/benchmark/compare-revisions.js",
    "bench:check": "node ./util/benchmark/bench-check.js",
    "bench:reanalyze": "node ./util/benchmark/compare-bench.js",
    "bench:analyze": "node ./util/benchmark/analyze-cpuprofile.js",
    "test:benchmark": "node --test util/benchmark/test/*.js",
    "test:benchmark:simulation": "node util/benchmark/statistical-simulation.js",
    "test:benchmark:e2e": "node --test util/benchmark/e2e/*.e2e.js",
    "test": "pnpm lint && pnpm test:unit && pnpm test:util && pnpm test:site && pnpm test:integration",
    "test:performance": "node --test --test-concurrency=1 --test-reporter=spec \"packages/postcss-svgo/perf/*.js\" \"packages/cssnano/perf/*/*.js\"",
    "test:coverage": "cd packages && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=../lcov.info",
    "test:uncovered-branches": "node util/uncoveredBranches.js",
    "test:unit": "pnpm --recursive --workspace-concurrency=1 exec node --test --test-reporter=dot --test-skip-pattern=\"framework tests\"",
    "test:util": "node --test util/webref/*.test.js util/mutation-testing/*.test.js",
    "test:site": "node --test site/test/*.js",
    "test:integration": "node --test packages/cssnano/test/presets/default/integrations.test.js packages/cssnano/test/presets/default/pluginIdempotency.test.js packages/cssnano/test/presets/advanced/integrations.test.js packages/cssnano/test/presets/lite/integrations.test.js",
    "test:packaging": "node --test util/packaging.test.js",
    "test:mutation": "node util/mutation-testing/mutation-runner.js --catalog packages/cssnano/mutation/postcss-discard-empty/mutation-catalog.js --catalog packages/cssnano/mutation/postcss-discard-comments/mutation-catalog.js --catalog packages/cssnano/mutation/postcss-normalize-whitespace/mutation-catalog.js --catalog packages/cssnano/mutation/postcss-normalize-positions/mutation-catalog.js --catalog packages/cssnano/mutation/postcss-merge-longhand/mutation-catalog.js --catalog packages/cssnano/mutation/postcss-merge-longhand/mutation-catalog-validity.js --catalog packages/cssnano/mutation/postcss-merge-longhand/mutation-catalog-candidates.js --catalog packages/cssnano/mutation/postcss-merge-longhand/mutation-catalog-reset-gates.js",
    "types": "tsc -b"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "knip": "^6.41.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss": "catalog:",
    "resolve": "^1.22.13",
    "typescript": "~7.0.2"
  },
  "browserslist": {
    "production": [
      "IE 11 and last 2 versions"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0"
    }
  }
}
