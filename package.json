{
  "name": "cssnano-core",
  "private": true,
  "scripts": {
    "lint": "pnpm types && oxlint . && oxfmt --check",
    "fixlint": "oxfmt . && pnpm oxlint --fix .",
    "build:integration": "node ./util/buildFrameworks.mjs",
    "bench": "node ./util/bench.mjs",
    "bench:profile": "node ./util/bench.mjs --profile",
    "bench:compare": "node ./util/compare-bench.mjs",
    "bench:analyze": "node ./util/analyze-cpuprofile.mjs",
    "test": "pnpm lint && pnpm test:unit && pnpm test:site && pnpm test:integration",
    "test:coverage": "cd packages && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=../lcov.info",
    "test:unit": "pnpm --recursive --workspace-concurrency=1 exec node --test --test-reporter=dot --test-skip-pattern=\"framework tests\"",
    "test:site": "node --test site/test/*.js",
    "test:integration": "node --test packages/cssnano-preset-default/test/integrations.js packages/cssnano-preset-advanced/test/integrations.js packages/cssnano-preset-lite/test/integrations.js",
    "test:watch": "node --test --watch",
    "test:failed": "node --test --test-rerun-failures=.test-failures.json",
    "test:mutation": "node util/mutation-testing/mutation-runner.mjs --catalog packages/postcss-discard-empty/mutation-catalog.mjs --catalog packages/postcss-discard-comments/mutation-catalog.mjs --catalog packages/postcss-normalize-whitespace/mutation-catalog.mjs",
    "types": "tsc -b",
    "all-publish": "pnpm stage publish -r"
  },
  "engines": {
    "node": "^22.11 || ^24.11 || >=26.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "knip": "^6.32.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "~7.0.2",
    "postcss": "catalog:"
  },
  "browserslist": {
    "production": [
      "IE 11 and last 2 versions"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0"
    }
  }
}
