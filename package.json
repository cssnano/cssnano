{
  "name": "cssnano-core",
  "private": true,
  "scripts": {
    "lint": "pnpm types && oxlint . && oxfmt --check",
    "fixlint": "oxfmt . && pnpm oxlint --fix .",
    "build:integration": "node ./util/buildFrameworks.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info",
    "test:unit": "node --test --test-skip-pattern=\"framework tests\"",
    "test:integration": "node --test packages/cssnano-preset-default/test/integrations.js packages/cssnano-preset-advanced/test/integrations.js packages/cssnano-preset-lite/test/integrations.js",
    "test:watch": "node --test --watch",
    "test:failed": "node --test --test-rerun-failures=.test-failures.json",
    "types": "tsc -b",
    "all-publish": "pnpm stage publish -r"
  },
  "engines": {
    "node": "^22.11 || ^24.11 || >=26.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "postcss": "^8.5.26",
    "typescript": "~7.0.2"
  },
  "browserslist": {
    "production": [
      "IE 11 and last 2 versions"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0"
    }
  }
}
