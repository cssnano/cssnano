{
  "name": "cssnano-core",
  "private": true,
  "type": "module",
  "scripts": {
    "fixlint": "oxfmt . && pnpm oxlint --fix .",
    "acquire": "pnpm --filter cssnano run acquire",
    "build:integration": "node util/buildFrameworks.js",
    "bench:profile": "node ./util/benchmark/child.js --profile=bench-results/profile.cpuprofile",
    "bench:compare": "node ./util/benchmark/bench.js --corpus",
    "bench:check": "node ./util/benchmark/bench.js",
    "test": "node util/verify.js",
    "mutation": "node util/mutation-testing/mutation-runner.js"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "knip": "^6.44.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postcss": "catalog:",
    "typescript": "~7.0.2"
  },
  "browserslist": {
    "production": [
      "IE 11 and last 2 versions"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0"
    }
  }
}
