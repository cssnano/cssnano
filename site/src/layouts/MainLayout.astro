---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  date?: Date;
  showTitle?: boolean;
  sidebar?: boolean;
  description?: string;
  type?: 'website' | 'article';
}

const { title, date, showTitle = true, sidebar = false, description, type } = Astro.props;
---
<BaseLayout title={title} description={description} type={type}>
  {sidebar && <Sidebar slot="sidebar" />}
  <article class="stack prose">
    {showTitle && <h1>{title}</h1>}
    <slot />
    {date && <p class="annotation">Last updated on <FormattedDate date={date} /></p>}
  </article>
</BaseLayout>
