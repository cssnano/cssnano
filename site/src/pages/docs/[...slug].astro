---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { repositoryPages } from '../../_data/repositoryPages.js';
import { getLastModified } from '../../utils/lastModified.js';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const repository = await getCollection('repository');
  return [
    ...docs.map((entry) => ({
      params: { slug: entry.id },
      props: {
        entry,
        title: entry.data.title,
        description: entry.data.description,
        showTitle: true,
      },
    })),
    ...repository.map((entry) => ({
      params: { slug: entry.id },
      props: {
        entry,
        title: repositoryPages[entry.id].title,
        description: repositoryPages[entry.id].description,
        showTitle: false,
      },
    })),
  ];
}

const { entry, title, description, showTitle } = Astro.props;
const { Content } = await render(entry);
const date = getLastModified(entry.filePath);
---
<MainLayout
  title={title}
  description={description}
  sidebar
  showTitle={showTitle}
  date={date}
>
  <Content />
</MainLayout>
