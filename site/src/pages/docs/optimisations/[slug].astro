---
import CodeSample from '../../../components/CodeSample.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import optimisations from '../../../_data/optimisations.js';
import { optimisationSlug } from '../../../utils/navigation.js';

export function getStaticPaths() {
  return optimisations.map((optimisation) => ({
    params: { slug: optimisationSlug(optimisation.shortName) },
    props: { optimisation },
  }));
}

const { optimisation } = Astro.props;
---
<MainLayout title={optimisation.shortName} description={optimisation.shortDescription}>
  <p>{optimisation.longDescription}</p>
  {optimisation.option && <p>Preset option: <code>{optimisation.option}</code></p>}
  <h2>Example</h2>
  <h3 id="example-input">Input</h3>
  <CodeSample code={optimisation.inputExample} lang="css" labelledBy="example-input" />
  <h3 id="example-output">Output</h3>
  <CodeSample code={optimisation.outputExample} lang="css" labelledBy="example-output" />
</MainLayout>
