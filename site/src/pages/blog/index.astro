---
import { getCollection } from 'astro:content';
import NoSidebar from '../../layouts/NoSidebar.astro';
const posts = await getCollection('blog');
---
<NoSidebar title="Blog"><ul class="list">{posts.map((post) => <li><h2><a href={`${import.meta.env.BASE_URL}blog/${post.data.slug}/`}>{post.data.title}</a></h2> {post.data.readableDate}</li>)}</ul></NoSidebar>
