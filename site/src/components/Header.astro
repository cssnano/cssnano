---
import LogoAlt from '../assets/logo-alt.svg';
import { currentLink } from '../utils/navigation.js';
import { headerExternalLinks, headerLinks, page } from '../_data/navigation.js';

const current = currentLink(Astro.url.pathname, headerLinks);
---
<header class="navbar full-bleed">
  <a href="#main" class="skiplink sr-only">Skip to Content</a>
  <nav class="cluster" aria-label="Main">
    <a href={page('')}>
      <LogoAlt width={160} role="img" aria-label="cssnano home" />
    </a>
    <span class="cluster">
      {headerLinks.map((link) => (
        <a href={link.href} aria-current={link === current ? 'page' : undefined}>{link.label}</a>
      ))}
      {headerExternalLinks.map((link) => (
        <a href={link.href} class:list={{ 'external-link': link.external }}>{link.label}{link.external && <span class="sr-only"> (external)</span>}</a>
      ))}
    </span>
  </nav>
</header>

<style>
  @layer components {
    .navbar {
      --cluster-gap: var(--space-md);

      padding-block: var(--space-xl);
      border-block-end: var(--theme-border-width) solid var(--theme-border);
    }

    /* A 24px line plus 10px above and below gives each link a 44px target (WCAG 2.5.5). */
    .navbar a {
      color: inherit;
      padding-block: 0.625rem;
      text-decoration: none;
    }

    .navbar a:hover,
    .navbar a:active {
      color: var(--theme-accent);
      text-decoration: underline;
    }

    /* Colour stays as set, so a focused skip link keeps its on-accent text. */
    .navbar a:focus-visible {
      text-decoration: underline;
    }

    /* Header items are centred vertically. */
    .navbar .cluster {
      align-items: center;
    }

    /* On one row, the logo starts on the content edge and the links finish on the other. */
    .navbar > .cluster {
      justify-content: space-between;
    }

    /* Underline and colour mark the current page, so sighted users get the same cue as assistive tech. */
    .navbar a[aria-current='page'] {
      color: var(--theme-accent);
      text-decoration: underline;
      text-decoration-thickness: 0.125rem;
      text-underline-offset: 0.3em;
    }

    /* Shown only while focused; the global sr-only rule hides it otherwise, without overriding its padding. */
    .skiplink:focus {
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: var(--z-header);
      display: block;
      padding: var(--space-xs);
      font-size: larger;
      text-align: center;
      background-color: var(--theme-accent);
      color: var(--theme-on-accent);
      /* Outside the accent fill, so the ring shows against the white header in light mode. */
      --focus-color: var(--theme-text);
    }
  }
</style>
