---
const { title, pathname = '/' } = Astro.props;
const canonicalPathValue = pathname.startsWith(import.meta.env.BASE_URL) ? pathname : `${import.meta.env.BASE_URL}${pathname.replace(/^\/+/, '')}`;
const canonicalPath = canonicalPathValue.endsWith('/') ? canonicalPathValue : `${canonicalPathValue}/`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}img/favicon.svg`} />
<link rel="alternate icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}img/favicon.ico`} />
<link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
<link rel="canonical" href={new URL(canonicalPath, Astro.site).href} />
<title>{title}</title>
<meta property="og:title" content={title} />
<meta property="og:type" content="article" />
<meta property="og:url" content={new URL(canonicalPath, Astro.site).href} />
<meta property="og:locale" content="en" />
<meta name="description" property="og:description" content="CSSNANO - postcss based css optimizer" />
<meta property="og:site_name" content="CSSNANO documentation" />
