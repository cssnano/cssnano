---
import { currentLink } from '../utils/navigation.js';
import { sidebarSections } from '../_data/navigation.js';

const current = currentLink(Astro.url.pathname, sidebarSections.flatMap(({ links }) => links));
---
<div class="sidebar">
  <nav aria-label="Documentation">
    <ul class="stack list-reset sidebar-groups">
      {sidebarSections.map(({ heading, links }, index) => (
        <li>
          <p class="nav-heading" id={`sidebar-group-${index}`}>{heading}</p>
          <ul class="list-reset" aria-labelledby={`sidebar-group-${index}`}>
            {links.map((link) => (
              <li class="nav-link">
                <a href={link.href} aria-current={link === current ? 'page' : undefined}>{link.label}</a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  @layer components {
    .sidebar-groups {
      --stack-space: var(--space-sm);
    }

    /* Group labels name their list with aria-labelledby, so they are text rather than headings. */
    .nav-heading {
      font-size: var(--step-1);
      font-weight: var(--font-weight-strong);
      line-height: 1.2;
    }

    /* A 24px line plus 10px above and below gives each link a 44px target (WCAG 2.5.5). */
    .nav-link a {
      font-size: 1rem;
      padding: 0.625rem var(--space-md);
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.2em;
      display: block;
      transition: background-color var(--transition-fast), color var(--transition-fast);
    }

    .nav-link a:hover,
    .nav-link a:focus-visible {
      background-color: var(--theme-bg-offset);
    }

    .nav-link a[aria-current='page'] {
      color: var(--theme-accent);
      background-color: var(--theme-accent-light);
      border-inline-start: var(--theme-active-bar-width) solid var(--theme-accent);
      font-weight: var(--font-weight-strong);
    }
  }
</style>
