---
import { footerColumns } from '../_data/navigation.js';
import cssnanoPackage from '../../../packages/cssnano/package.json';
---
<footer class="dark-panel full-bleed">
  <div class="cluster">
    {footerColumns.map(({ heading, links }) => (
      <div class="stack">
        <h2 class="text-large">{heading}</h2>
        <ul class="stack list-reset footer-links">
          {links.map((link) => (
            <li>
              <a href={link.href} class:list={{ 'external-link': link.external }}>{link.label}{link.external && <span class="sr-only"> (external)</span>}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <p class="text-center">Latest release {cssnanoPackage.version} · Distributed under the MIT License.</p>
</footer>

<style>
  @layer components {
    /* Padding and row gap space the footer without changing its subgrid layout. */
    footer {
      padding-block: var(--space-xl);
      row-gap: var(--space-md);
    }

    /* Inline-block lets the padding enlarge the target to 44px (WCAG 2.5.5) without altering the line box. */
    footer a {
      display: inline-block;
      padding-block: 0.625rem;
      color: inherit;
      text-decoration: none;
    }

    footer a:hover,
    footer a:focus-visible {
      text-decoration: underline;
    }

    /* Link groups use a tighter stack than the default. */
    .footer-links {
      --stack-space: var(--space-sm);
    }
  }
</style>
