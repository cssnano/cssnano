{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test && pnpm typecheck",
    "typecheck": "tsc --project tsconfig.json",
    "build:metadata": "node ./util/buildMetadata.mjs",
    "start": "eleventy --serve --input src/",
    "build": "eleventy --input src/"
  },
  "dependencies": {
    "cssnano-preset-advanced": "link:../packages/cssnano-preset-advanced",
    "cssnano-preset-default": "link:../packages/cssnano-preset-default",
    "cssnano-preset-lite": "link:../packages/cssnano-preset-lite",
    "postcss": "^8.5.26",
    "svgo": "^4.0.2"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "cssnano": "link:../packages/cssnano",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "smol-toml": "^1.7.1",
    "typescript": "~7.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0"
    }
