{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=dot && pnpm typecheck",
    "typecheck": "astro sync && tsc --project tsconfig.json",
    "start": "astro dev",
    "build": "astro build",
    "check:astro": "pnpm build && node util/checkAstroArtifacts.js"
  },
  "dependencies": {
    "postcss": "^8.5.31"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.1",
    "cssnano": "link:../packages/cssnano",
    "typescript": "~7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0"
    }
  },
  "browserslist": [
    "defaults and baseline widely available with downstream"
  ]
}
