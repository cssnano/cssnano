{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025", "dom", "dom.iterable"],
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true
  },
  "include": [".astro/types.d.ts", ".astro/content.d.ts", "src/**/*.js", "src/**/*.ts"],
  "exclude": ["node_modules", "test"]
}
