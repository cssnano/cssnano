{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025", "dom", "dom.iterable"],
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "paths": {
      "#postcss-*": ["../packages/cssnano/src/plugins/postcss-*/index.js"],
      "#presets/*": ["../packages/cssnano/src/presets/*.js"],
      "#stylehacks": ["../packages/cssnano/src/utils/stylehacks/index.js"],
      "#utils": ["../packages/cssnano/src/utils/index.js"],
      "#utils/browser-bugs": ["../packages/cssnano/src/utils/browserBugs.js"],
      "#utils/browser-support": [
        "../packages/cssnano/src/utils/browserSupport.js"
      ],
      "#utils/browser-targets": [
        "../packages/cssnano/src/utils/browserTargets.js"
      ],
      "#utils/versions": ["../packages/cssnano/src/utils/versions.js"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    ".astro/content.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "../packages/cssnano/src/utils/caniuse-lite.d.ts"
  ],
  "exclude": ["node_modules", "test"]
}
