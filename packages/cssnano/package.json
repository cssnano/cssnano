  },
  "scripts": {
    "acquire": "pnpm run \"/^acquire:/\"",
    "acquire:postcss-colormin": "node ./script/postcss-colormin/acquire.js",
    "acquire:postcss-merge-idents": "node ./script/postcss-merge-idents/acquire.js",
    "acquire:postcss-merge-longhand": "node ./script/postcss-merge-longhand/acquire.js",
