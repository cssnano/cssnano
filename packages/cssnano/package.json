    },
    "./presets/lite": {
      "types": "./types/presets/lite.d.ts",
      "default": "./src/presets/lite.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "imports": {
