{
  "name": "postcss-reduce-initial",
  "version": "8.0.2",
  "description": "Reduce initial definitions to the actual initial value, where possible.",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./src": "./src/index.js",
    "./src/index": "./src/index.js",
    "./src/index.js": "./src/index.js",
    "./src/lib/ignoreProps": "./src/lib/ignoreProps.js",
    "./src/lib/ignoreProps.js": "./src/lib/ignoreProps.js",
    "./package.json": "./package.json"
  },
  "imports": {
    "#getBrowsersList": {
      "node": "./src/lib/computeBrowsersToSupport.js",
      "default": "./src/lib/getBrowsersForWebBuild.js"
    }
  },
  "files": [
    "src",
    "LICENSE-MIT",
    "types"
  ],
  "scripts": {
    "acquire": "node ./src/script/acquire.mjs"
  },
  "keywords": [
    "css",
    "postcss",
    "postcss-plugin"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cssnano/cssnano",
  "author": {
    "name": "Ben Briggs",
    "email": "beneb.info@gmail.com",
    "url": "https://beneb.info"
  },
  "repository": "cssnano/cssnano",
  "dependencies": {
    "browserslist": "^4.28.7",
    "caniuse-api": "^4.0.0"
  },
  "bugs": {
    "url": "https://github.com/cssnano/cssnano/issues"
  },
  "engines": {
    "node": "^22.11.0 || ^24.11.0 || >=26.0"
  },
  "devDependencies": {
    "mdn-data": "^2.29.0",
    "postcss": "^8.5.25"
  },
  "peerDependencies": {
    "postcss": "^8.5.25"
  }
}
